# Flutter / Dart
.dart_tool/
.packages
build/
pubspec.lock

# Generated Android platform folder (rebuilt in CI by tools/scaffold_android.sh)
android/

# Bundled web assets are generated by tools/prepare_web.sh at build time;
# only the placeholder is committed.
assets/web/*
!assets/web/.gitkeep

# Misc
*.iml
.idea/
.DS_Store

# Native map rasters are decoded from tools/maps_b64/ at build time
assets/maps/*.webp
